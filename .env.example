# ==============================================================================
# Voice AI Platform Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables for your deployment environment.
# For local testing without external API keys, leave providers as "mock".

# Application Settings
APP_NAME=VoiceAI Platform
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_PREFIX=/api/v1
SECRET_KEY=dev-secret-key-change-in-production

# Latency SLA Target (ms)
TARGET_MAX_LATENCY_MS=800.0

# Provider Selection: "mock", "gemini_live", "deepgram", "google"
# Set to "mock" for zero-credential local development and automated testing
LLM_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock

# Google Gemini & Vertex AI Configuration (Used when LLM_PROVIDER=gemini_live)
GEMINI_API_KEY=
VERTEX_PROJECT_ID=ml-odio
VERTEX_LOCATION=asia-south1
LLM_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=vertex_creds.json

# Deepgram Configuration (Used when STT_PROVIDER=deepgram or TTS_PROVIDER=deepgram)
DEEPGRAM_API_KEY=
TTS_VOICE_NAME=aura-asteria-en

# Database Configuration (Async SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./voice_ai.db
DB_ECHO=false

# Twilio Telephony Credentials (Optional - simulated mode used if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+18005550199

# Observability & Metrics
ENABLE_PROMETHEUS=true
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
RATE_LIMIT_CALLS_PER_MIN=60
